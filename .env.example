APP_NAME="AIVOA Pharmaceutical Complaint QMS"
ENVIRONMENT=development

# PostgreSQL (recommended for production / Docker)
# DATABASE_URL=postgresql+asyncpg://aivoa:aivoa@localhost:5432/aivoa_qms

# SQLite (local dev without Docker/PostgreSQL)
DATABASE_URL=sqlite:///./aivoa.db

AUTO_CREATE_TABLES=true
AI_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=storage/uploads
